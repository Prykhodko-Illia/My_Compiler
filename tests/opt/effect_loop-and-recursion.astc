Program
  Fn spin -> i32
    Param a i32
    Block
      Decl i i32 mut
        Const 0
      While
        BinOp !=
          Var i
          Var a
        Block
          Assign i
            BinOp +
              Var i
              Const 1
      Exit
        Var i
  Fn fact -> i32
    Param n i32
    Block
      Decl r i32 mut
        Const 1
      If
        BinOp !=
          Var n
          Const 0
        Block
          Decl rest i32 const
            Call fact
              BinOp -
                Var n
                Const 1
          Assign r
            BinOp *
              Var n
              Var rest
      Exit
        Var r
  Decl s i32 const
    Call spin
      Const 3
  Decl f i32 const
    Call fact
      Const 4
  Print
    Const 1
  Exit
    Const 0
