Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i32 mut
  Decl p Point mut
    Const 1
    Const 2
  Decl q Point const
    Var p
  Assign p.x
    Const 100
  Decl r i32 const
    BinOp +
      Field q.x
      Field p.x
  Exit
    Var r
