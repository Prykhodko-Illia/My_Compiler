Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i32 mut
  Decl p Point const
    Const 10
    Const 20
  Decl c Circle const
    Var p
    Const 5
  Decl xCoord i32 const
    Field c.center.x
  Exit
    Var xCoord
