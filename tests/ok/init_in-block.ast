Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i64 mut
  If
    Bool true
    Block
      Decl c Circle mut
        Init
          Const 1
          Const 2
        Const 3
      While
        BinOp !=
          Field c.radius
          Const 6
        Block
          Assign c.radius
            BinOp +
              Field c.radius
              Const 1
      Exit
        Field c.radius
  Exit
    Const 0
