Program
  Struct Point
    FieldDecl x i32 mut
    FieldDecl y i32 mut
  Struct Circle
    FieldDecl center Point const
    FieldDecl radius i64 mut
  Fn mk -> Point
    Param v i32
    Block
      Decl q Point const
        Var v
        BinOp *
          Var v
          Const 2
      Exit
        Var q
  Fn size -> i64
    Param k Circle
    Block
      Exit
        Field k.radius
  Decl a Circle const
    Call mk
      Const 4
    Const 1
  Decl b Circle const
    Init
      Field a.center.y
      Const 6
    BinOp +
      Field a.radius
      Const 9
  Decl s i64 const
    BinOp +
      BinOp +
        Field b.center.x
        Field b.center.y
      Call size
        Var b
  Exit
    Var s
